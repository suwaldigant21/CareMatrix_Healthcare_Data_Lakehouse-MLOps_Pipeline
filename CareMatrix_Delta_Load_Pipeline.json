    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst jsonString = JSON.stringify(data.data, null, 2);\n\nreturn [{\n  json: {\n    page: Number(data.page),\n    total_pages: Number(data.total_pages)\n  },\n  binary: {\n    data: {\n      data: Buffer.from(jsonString).toString('base64'),\n      mimeType: 'application/json',\n      fileName: `claims_batch_page_${data.page}.json`\n    }\n  }\n}];"
      },
      "id": "d674e991-2a45-4665-b6e2-d13fd68bd2f0",
