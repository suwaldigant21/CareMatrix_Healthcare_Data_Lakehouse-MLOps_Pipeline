        "jsCode": "// const staticData = $getWorkflowStaticData(\"global\");\n// delete staticData.lastRun;\n// return { reset: true };\n\n\n// Access n8n's permanent memory\nconst staticData = $getWorkflowStaticData(\"global\");\n\n// If it's the first run, start at Jan 1, 2026. Otherwise, use the saved watermark.\nconst lastRun = staticData.lastRun || '2026-01-01T00:00:00';\n\nreturn {\n  page: 1,\n  limit: 1000,\n  lastRun: lastRun\n};"
      },
