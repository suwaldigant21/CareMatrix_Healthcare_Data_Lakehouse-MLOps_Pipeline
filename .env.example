# ============================================================
# CareMatrix Lakehouse - local environment template
# Copy to `.env` (gitignored) and customize for your own AWS account.
# Values shown are non-production demo defaults for the synthetic DE-SynPUF
# pipeline. All sensitive values are injected here, never hardcoded in code.
# ============================================================

# Auth token for the local mock claims API (fastapi_server).
# Must match the X-API-KEY header configured in the n8n workflow
# (CareMatrix_Delta_Load_Pipeline.json).
CAREMATRIX_API_KEY=carematrix-demo-token

# Salt used for PHI masking (SHA-256 of patient identifier + salt) in both
# the Bronze->Silver Glue job AND the dbt beneficiary staging model.
# The two sides MUST use the identical salt or downstream joins break.
CAREMATRIX_PHI_SALT=carematrix-salt-2026

# AWS resource names -- replace with your own account's globally-unique values.
# dbt-athena profile (carematrix_dbt/profiles.yml) and the ML trainer
# (ml/train_readmission_model.py) fall back to these if unset.
CAREMATRIX_S3_STAGING_DIR=s3://carematrix-lakehouse-dev-demo/athena-results/
CAREMATRIX_S3_DATA_DIR=s3://carematrix-lakehouse-dev-demo/
CAREMATRIX_BRONZE_PATH=s3://carematrix-lakehouse-dev-demo/bronze/inpatient_claims/
CAREMATRIX_SILVER_PATH=s3://carematrix-lakehouse-dev-demo/silver/inpatient_claims/
CAREMATRIX_ATHENA_RESULTS=s3://carematrix-lakehouse-dev-demo/athena-results/

# Terraform: give your own globally-unique suffix to S3 bucket names
# (see terraform/variables.tf -> bucket_suffix).
